{
  "name": "innercove",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "npm run build --workspace=@innercove/core && tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "typecheck": "npm run typecheck --workspace=@innercove/core && tsc --noEmit",
    "validate": "npm run validate --workspace=@innercove/core",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  }
}
