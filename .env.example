# Copy to .env (untracked). Never commit real values.
INFERENCE_PROVIDER=lmstudio          # fake works only with NODE_ENV=test
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=qwen/qwen3.8-27b
LOCAL_AI_API_KEY=                    # from ~/.config/innercove/lmstudio.token
INFERENCE_ACCELERATION=unknown       # cuda | vulkan | cpu | unknown, shown on the privacy panel (GX10: cuda)
DEV_STORE=                           # legacy flag, ignored; saved chat uses SQLCipher
HOST=127.0.0.1
PORT=8000

# Credentials are submitted only through setup/unlock, never env vars.
DB_PATH=data/innercove.db
DB_ENCRYPTION=sqlcipher

# Optional local voice prototype; no auto-download/cloud fallback.
# Absolute local paths only. D47 session verifier integration is required.
STT_WHISPER_BIN=
STT_MODEL_PATH=
STT_FFMPEG_BIN=
