{
  "name": "@innercove/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod contracts: persisted records, create/update inputs, API request/response shapes, and the minimal data-layer ports role A reads from. Owned by role B.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run build && node dist/validate/run.js"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
