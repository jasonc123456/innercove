{
  "name": "@innercove/server",
  "version": "0.0.0",
  "private": true,
  "description": "InnerCove app server (plan \u00a73): Fastify API (api/), chat pipeline (chat/), inference providers (inference/), store (store/, B).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spike:sqlcipher": "npm run build && node dist/store/sqlcipher-spike.js",
    "smoke:db": "npm run build && node scripts/smoke-db.mjs",
    "seed:persona": "npm run build && node scripts/seed-persona.mjs"
  },
  "dependencies": {
    "@innercove/core": "*",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "zod": "^4.6.5",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^9.6.0"
  }
}
